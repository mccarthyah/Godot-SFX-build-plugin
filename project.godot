; Engine configuration file.
; It's best edited using the editor UI and not directly.

config_version=5

[application]

config/name="SFX Generator Demo"
config/description="Demo project for the SFX Generator plugin. Open the SFX Generator dock (View menu) to browse presets, preview and export WAVs."
run/main_scene="res://demo.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[editor_plugins]

enabled=PackedStringArray("res://addons/sfx_generator/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
